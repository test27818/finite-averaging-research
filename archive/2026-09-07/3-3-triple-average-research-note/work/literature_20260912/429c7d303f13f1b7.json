ataLayer || [];\n      function gtag(){dataLayer.push(arguments);}\n      gtag('js', new Date());\n\n      gtag('config', 'G-YVBFDNX374');\n    </script>\n\n  </head><body class=\"\"><div id=\"layout\">\n<div id=\"page-wrapper\">\n<div id=\"header\">\n    <div id=\"logo\"><a href=\"/\">\n    <img src=\"/static/images/lmfdb-logo.png\" />\n</a></div>\n    <div class=\"right\">\n      <div class=\"upper\">\n        <div class=\"bread\">\n                      <a href=\"/\">&#8962;</a>\n            &rarr; <a href=\"/ModularForm/\"> Modular forms</a>\n            &rarr; <a href=\"/ModularForm/GL2/Q/holomorphic/\"> Classical</a>\n            &rarr; <a href=\"/ModularForm/GL2/Q/holomorphic/27/\"> Level 27</a>\n            &rarr; <a href=\"/ModularForm/GL2/Q/holomorphic/27/1/\"> Weight 1</a>\n                               </div>\n        <div class=\"topright\">\n                                      <!--\n            <span id=\"communication-wrapper\">\n              <img id=\"communication-img\" src=\"/static/images/progress-green.gif\" />\n              <span id=\"communication\"></span>\n            </span>\n-->\n          <div class=\"undertopright\">\n            <a href=\"/citation\" >Citation</a>\n              &middot;\n            <a href=\"/contact\" target=\"_blank\">Feedback</a>\n              &middot;\n            <a href=\"#\" id=\"menutoggle\">Hide Menu\n                        </a>\n          </div>\n        </div>\n      \n        </div>\n        <div id=\"title\">Space of modular forms of level 27 and weight 1</div>\n\n    </div>\n</div>\n\n<div id=\"sidebar\">\n<h2>Introduction</h2>\n\n\n\n\n\n  <table class=\"short\">\n  <tr>\n  <td scope=\"col\" width=\"20%\"><a href=\"/intro\">Overview</a><td scope=\"col\" width=\"20%\"><a href=\"/random\">Random</a></tr><tr><td scope=\"col\" width=\"20%\"><a href=\"/universe\">Universe</a><td scope=\"col\" width=\"20%\"><a href=\"/knowledge/\">Knowledge</a></tr><tr></tr>\n</table>\n\n\n \n<h2>L-functions</h2>\n\n\n\n\n\n  <table class=\"short\">\n  <tr>\n  <td scope=\"col\" width=\"20%\"><a href=\"/L/rational\">Rational</a><td scope=\"col\" width=\"20%\"><a href=\"/L/\">All</a></tr><tr></tr>\n</table>\n\n\n \n<h2>Modular forms</h2>\n\n\n\n\n\n  <table class=\"short\">\n  <tr>\n  <td scope=\"col\" width=\"20%\"><a href=\"/ModularForm/GL2/Q/holomorphic/\">Classical</a><td scope=\"col\" width=\"20%\"><a href=\"/ModularForm/GL2/Q/Maass/\">Maass</a></tr><tr><td scope=\"col\" width=\"20%\"><a href=\"/ModularForm/GL2/TotallyReal/\">Hilbert</a><td scope=\"col\" width=\"20%\"><a href=\"/ModularForm/GL2/ImaginaryQuadratic/\">Bianchi</a></tr><tr></tr><tr></tr><tr></tr><tr></tr><tr></tr>\n</table>\n\n\n \n<h2>Varieties</h2>\n\n\n\n\n\n  <table class=\"short\">\n  <tr>\n  <td colspan=2><span class=\"collapsible-container\">\n        Elliptic curves\n\t<div class=\"collapsible-content\"><div><span class=\"subtitle\"><a href=\"/EllipticCurve/Q/\">over $\\Q$</a></span></div><div><span class=\"subtitle\"><a href=\"/EllipticCurve/\">over number fields</a></span></div></div></td></tr><tr></tr><tr></tr><tr><td colspan=2><a href=\"/Genus2Curve/Q/\">Genus 2 curves</a></tr><tr></tr><tr></tr><tr></tr><tr></tr><tr></tr><tr></tr><tr></tr><tr></tr><tr></tr><tr></tr><tr></tr><tr><td colspan=2><a href=\"/HigherGenus/C/Aut/\">Higher genus families</a></tr><tr></tr><tr></tr><tr></tr><tr></tr><tr></tr><tr><td colspan=2><a href=\"/Variety/Abelian/Fq/\">Abelian varieties over $\\F_{q}$</a></tr><tr></tr><tr><td colspan=2><a href=\"/Belyi/\">Belyi maps</a></tr><tr></tr>\n</table>\n\n\n \n<h2>Fields</h2>\n\n\n\n\n\n  <table class=\"short\">\n  <tr>\n  <td colspan=2><a href=\"/NumberField/\">Number fields</a></tr><tr></tr><tr><td colspan=2><a href=\"/padicField/\">$p$-adic fields</a></tr><tr></tr><tr></tr><tr></tr><tr></tr>\n</table>\n\n\n \n<h2>Representations</h2>\n\n\n\n\n\n  <table class=\"short\">\n  <tr>\n  <td colspan=2><a href=\"/Character/Dirichlet/\">Dirichlet characters</a></tr><tr></tr><tr></tr><tr><td colspan=2><a href=\"/ArtinRepresentation/\">Artin representations</a></tr><tr></tr><tr></tr><tr></tr><tr></tr><tr></tr><tr></tr>\n</table>\n\n\n \n<h2>Groups</h2>\n\n\n\n\n\n  <table class=\"short\">\n  <tr>\n  <td colspan=2><a href=\"/GaloisGroup/\">Galois groups</a></tr><tr></tr><tr><td colspan=2><a href=\"/SatoTateGroup/\">Sato-Tate groups</a></tr><tr><td colspan=2><span class=\"collapsible-container\">\n        Abstract groups\n\t<div class=\"collapsible-content\"><div><span class=\"subtitle\"><a href=\"/Groups/Abstract/\">groups</a></span></div><div><span class=\"subtitle\"><a href=\"/Groups/Abstract/Subgroups\">subgroups</a></span></div><div><span class=\"subtitle\"><a href=\"/Groups/Abstract/ComplexCharacters\">characters</a></span></div><div><span class=\"subtitle\"><a href=\"/Groups/Abstract/ConjugacyClasses\">conjugacy classes</a></span></div></div></td></tr><tr></tr><tr></tr><tr><td scope=\"col\" width=\"40%\">    </td></tr><tr></tr>\n</table>\n\n\n \n<h2><a href=\"/api/options\">Database</a></h2>\n\n\n\n\n\n\n \n  <script>\n    $(document).ready(function() {\n\n      function setToggleState($toggle, expanded, label) {\n          $toggle.toggleClass('open', expanded);\n          $toggle.attr('aria-expanded', expanded ? 'true' : 'false');\n          $toggle.attr('aria-label', (expanded ? 'Collapse ' : 'Expand ') + label);\n      }\n\n      // ── Collapsible sub-menu toggles (Elliptic curves, Abstract groups, …) ──\n      $('.collapsible-container').each(function(index) {\n          var $container = $(this);\n          var $content   = $container.find('.collapsible-content');\n          // Key from the container's OWN text only, excluding child elements\n          var ownText = $.trim($container.clone().children().remove().end().text());\n          var key = 'lmfdb_sidebar_entry_' +\n              ownText.replace(/\\s+/g, '_').substring(0, 30);\n          var contentId = 'lmfdb-sidebar-entry-' + index;\n          $content.attr('id', contentId);\n\n          var $chev = $('<button type=\"button\" class=\"collapsible-chevron open\"><svg aria-hidden=\"true\" focusable=\"false\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M9 6L15 12L9 18\" stroke=\"currentColor\" stroke-width=\"3\"/></svg></button>');\n          $chev.attr('aria-controls', contentId);\n          $content.before($chev);\n\n          // Open by default; collapse only if explicitly stored closed.\n          if (localStorage.getItem(key) === '0') {\n              $content.hide();\n              setToggleState($chev, false, ownText);\n          } else {\n              setToggleState($chev, true, ownText);\n          }\n\n          $container.on('click', function(e) {\n              // Let clicks inside the submenu through (links must work)\n              if ($(e.target).closest('.collapsible-content').length) return;\n\n              e.stopPropagation();\n              e.preventDefault();\n              var expanded = $chev.attr('aria-expanded') !== 'true';\n              setToggleState($chev, expanded, ownText);\n              $content.slideToggle(150);\n              localStorage.setItem(key, expanded ? '1' : '0');\n          });\n      });\n\n      // ── Section (h2) collapse/expand ─────────────────────────────────────────\n      $('#sidebar h2').each(function(index) {\n          var $h2      = $(this);\n          var $content = $h2.nextUntil('h2').not('script');\n          if ($content.length === 0) return; // 'single' type – nothing to collapse\n          var headingText = $.trim($h2.text());\n\n          // Wrap all content between this h2 and the next into one div\n          $content.wrapAll('<div class=\"section-content\"></div>');\n          var $section = $h2.next('.section-content');\n          var sectionId = 'lmfdb-sidebar-section-' + index;\n          $section.attr('id', sectionId);\n\n          // Append the chevron into the h2\n          var $chev = $('<button type=\"button\" class=\"collapsible-chevron open\"><svg aria-hidden=\"true\" focusable=\"false\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M9 6L15 12L9 18\" stroke=\"currentColor\" stroke-width=\"3\"/></svg></button>');\n          $chev.attr('aria-controls', sectionId);\n          $h2.append($chev);\n          $h2.css('cursor', 'pointer');\n\n          // Restore persisted state (default: open)\n          var key = 'lmfdb_sidebar_sec_' + headingText.replace(/\\s+/g, '_').substring(0, 30);\n          if (localStorage.getItem(key) === '0') {\n              $section.hide();\n              setToggleState($chev, false, headingText);\n          } else {\n              setToggleState($chev, true, headingText);\n          }\n\n          $h2.on('click', function(e) {\n              // Preserve any heading link that may be added in the future.\n              if ($(e.target).closest('a').length) return;\n              e.stopPropagation();\n              e.preventDefault();\n              var expanded = $chev.attr('aria-expanded') !== 'true';\n              setToggleState($chev, expanded, headingText);\n              $section.slideToggle(150);\n              localStorage.setItem(key, expanded ? '1' : '0');\n          });\n      });\n\n  });\n  </script></div>\n \n \n\n      <div id=\"properties\">\n           <h1 class=\"properties-header\">Properties</h1>\n       <div class=\"properties-body\">\n       <table>\n                  <tr><td class=\"label\">Label</td><td>\n                  27.1</td></tr>           <tr><td class=\"label\">Level</td><td>\n                  27</td></tr>           <tr><td class=\"label\">Weight</td><td>\n                  1</td></tr>           <tr><td class=\"label\">Dimension</td><td>\n                  0</td></tr>           <tr><td class=\"label\">Nonzero newspaces</td><td>\n                  0</td></tr>           <tr><td class=\"label\">Newform subspaces</td><td>\n                  0</td></tr>           <tr><td class=\"label\">Sturm bound</td><td>\n                  54</td></tr>      </table>\n      </div>\n    \n   \n   \n   \n   \n   \n       <h1 class=\"properties-header\">Downloads</h1>\n    <div class=\"properties-body\">\n        <ul>\n                           <li><a href=\"/ModularForm/GL2/Q/holomorphic/download_traces/27.1\">Trace form to text</a></li>\n                                   <li><a href=\"/ModularForm/GL2/Q/holomorphic/download_full_space/27.1\">All stored data to text</a></li>\n                                   <li><a href=\"/ModularForm/GL2/Q/holomorphic/data/27.1\">Underlying data</a></li>\n                    </ul>\n      </div>\n   \n   \n       <h1 class=\"properties-header\">Learn more</h1>\n    <div class=\"properties-body\">\n        <ul>\n                           <li><a href=\"/ModularForm/GL2/Q/holomorphic/Source\">Source and acknowledgments</a></li>\n                                   <li><a href=\"/ModularForm/GL2/Q/holomorphic/Completeness\">Completeness of the data</a></li>\n                                   <li><a href=\"/ModularForm/GL2/Q/holomorphic/Reliability\">Reliability of the data</a></li>\n                                   <li><a href=\"/ModularForm/GL2/Q/holomorphic/Labels\">Classical modular form labels</a></li>\n                                   <li><a href=\"/ModularForm/GL2/Q/holomorphic/mf_hecke_cc/\">Complex Hecke eigenvalues</a></li>\n                                   <li><a href=\"/ModularForm/GL2/Q/holomorphic/FormPictures\">Picture description</a></li>\n                    </ul>\n      </div>\n   \n    </div>\n<div id=\"main\">\n  <div id=\"content\">\n    <div id=\"flashes\">\n              </div>    <div align=\"right\" style=\"float: right; padding-left:10px;\" id=\"rawtseticonspot\" title=\"raw/typeset toggle\"></div>\n            \n<h2> Defining parameters </h2>\n\n<table>\n  <tr>\n    <td> <a title=\"Level of a modular form [cmf.level]\" knowl=\"cmf.level\" kwargs=\"\">Level</a>: </td>\n    <td> \\( N \\) </td>\n    <td>=</td>\n    <td> \\(  27 =  3^{3}   \\) </td>\n  </tr>\n  <tr>\n    <td> <a title=\"Weight of an elliptic modular form [cmf.weight]\" knowl=\"cmf.weight\" kwargs=\"\">Weight</a>: </td>\n    <td> \\( k \\) </td>\n    <td>=</td>\n    <td>\\( 1 \\)</td>\n  </tr>\n    <tr>\n    <td> Nonzero <a title=\"New subspace [cmf.newspace]\" knowl=\"cmf.newspace\" kwargs=\"\">newspaces</a>: </td>\n    <td></td>\n    <td></td>\n    <td> \\( 0 \\) </td>\n  </tr>\n      <tr>\n    <td> <a title=\"Newform subspace [cmf.newform_subspace]\" knowl=\"cmf.newform_subspace\" kwargs=\"\">Newform subspaces</a>: </td>\n    <td></td>\n    <td></td>\n    <td> \\( 0 \\) </td>\n  </tr>\n    <tr>\n    <td> <a title=\"Sturm bound for $\\Gamma_1(N)$ [cmf.sturm_bound_gamma1]\" knowl=\"cmf.sturm_bound_gamma1\" kwargs=\"\">Sturm bound</a>: </td>\n    <td></td>\n    <td></td>\n    <td> \\(54\\) </td>\n  </tr>\n  </table>\n\n<h2> Dimensions </h2>\n\n<p>The following table gives the dimensions of various subspaces of \\(M_{1}(\\Gamma_1(27))\\).</p>\n\n<table class=\"dimgrid\">\n  <thead>\n    <tr>\n      <th class=\"blank\"></th>\n      <th> Total </th>\n      <th> New </th>\n      <th> Old </th>\n    </tr>\n  </thead>\n  <tbody>\n        <tr>\n      <th class=\"left\"> Modular forms </td>\n            <td> 15 </td>\n            <td> 8 </td>\n            <td> 7 </td>\n          </tr>\n        <tr>\n      <th class=\"left\"> Cusp forms </td>\n            <td> 0 </td>\n            <td> 0 </td>\n            <td> 0 </td>\n          </tr>\n        <tr>\n      <th class=\"left\"> Eisenstein series </td>\n            <td> 15 </td>\n            <td> 8 </td>\n            <td> 7 </td>\n          </tr>\n      </tbody>\n</table>\n\n\n<p>The following table gives the dimensions of subspaces with specified <a title=\"Projective image [cmf.projective_image]\" knowl=\"cmf.projective_image\" kwargs=\"\">projective image type</a>.</p>\n\n<table class=\"ntdata\">\n  <thead>\n    <tr class='dark'>\n      <th></th>\n      <th><a title=\"Projective image [cmf.projective_image]\" knowl=\"cmf.projective_image\" kwargs=\"\">\\(D_n\\)</a></th>\n      <th><a title=\"Projective image [cmf.projective_image]\" knowl=\"cmf.projective_image\" kwargs=\"\">\\(A_4\\)</a></th>\n      <th><a title=\"Projective image [cmf.projective_image]\" knowl=\"cmf.projective_image\" kwargs=\"\">\\(S_4\\)</a></th>\n      <th><a title=\"Projective image [cmf.projective_image]\" knowl=\"cmf.projective_image\" kwargs=\"\">\\(A_5\\)</a></th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th class='dark'>Dimension</th>\n      <td>0</td>\n      <td>0</td>\n      <td>0</td>\n      <td>0</td>\n    </tr>\n  </tbody>\n</table>\n\n\n\n<!-- Definitions for coefficient fields -->\n\n\n      </div>\n</div>\n\n\n</div>\n<div id=\"footer\">\n    \n        <h4 style=\"margin:5px;\">This project is supported by <a href=\"/acknowledgment#sponsors\">grants</a> from the US National Science Foundation, the UK Engineering and Physical Sciences Research Council, and the Simons Foundation.</h4>\n    <div>\n      <a href=\"/contact\">Contact</a>\n      &middot;\n      <a href=\"/citation\">Citation</a>\n      &middot;\n      <a href=\"/license\">License</a>\n      &middot;\n      <a href=\"/acknowledgment\">Acknowledgments</a>\n      &middot;\n      <a href=\"/management\">Editorial Board</a>\n            &middot;\n      <a href=\"https://github.com/LMFDB/lmfdb/tree/cce7a1f96effc705340dced22560bf17249eb422\n\">Source</a>\n            &middot;\n      SageMath version 10.5\n      &middot;\n      LMFDB Release 1.2.1\n    </div>\n</div>\n</div>  </body>\n</html>"
